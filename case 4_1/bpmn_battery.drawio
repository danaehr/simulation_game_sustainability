        </mxCell>

        <mxCell id="8" value="AND Split" style="rhombus;fillColor=#d5e8ff;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="360" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="9" value="Evaporate" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
